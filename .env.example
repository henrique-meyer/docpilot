# Copy to .env and fill the values with your own resource names.
# .env is gitignored. Set DOCPILOT_ENV_FILE to keep the filled file outside this checkout.
# See docs/setup.md for each resource and secret.
# The process reads these variables. A value already set in the environment wins.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-6.1-sol
DOCPILOT_MAX_QUESTION_CHARS=1000
DOCPILOT_ASK_RATE_LIMIT=30
DOCPILOT_ASK_RATE_WINDOW_SECONDS=60
DOCPILOT_DAILY_TOKEN_CAP=20000
DOCPILOT_EVAL_CORRECTNESS=0.8
DOCPILOT_EVAL_CITATION_ACCURACY=0.9
DOCPILOT_EVAL_GROUNDEDNESS=0.8
DOCPILOT_EVAL_RED_TEAM_PASS_RATE=1.0
DOCPILOT_AGENT_MAX_TOOL_CALLS=6
DOCPILOT_AGENT_TIMEOUT_SECONDS=30
# Jaeger in Compose, for example http://jaeger:4318. Empty skips OTLP export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# 1 exports every trace. Lower it if the 0.1 GB daily cap gets close.
DOCPILOT_OTEL_SAMPLE_RATIO=1
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=docpilot
DOCPILOT_RETRIEVAL_TOP_K=8
DOCPILOT_RETRIEVAL_TOKEN_BUDGET=3000
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=sources
# Azurite only. Leave empty when using the Azure account with managed identity.
AZURE_STORAGE_CONNECTION_STRING=
# Local file store used when AZURE_STORAGE_ACCOUNT_URL is empty.
DOCPILOT_DATA_DIR=.data
# Print a hash with: uv run python -m docpilot.admin.hash_password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Set true behind HTTPS. Local HTTP must leave this false.
DOCPILOT_COOKIE_SECURE=
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX. Empty skips the tag.
DOCPILOT_GA_MEASUREMENT_ID=
